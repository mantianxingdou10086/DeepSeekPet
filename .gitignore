# Allowlist: keep local evidence, personal data and generated outputs out of Git.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/requirements-build.txt
!/pet.py
!/desktop_runtime.py
!/window_bounds.py
!/motion_timing.py
!/DeepSeekPet.spec
!/version_info.txt
!/pet.ico
!/run_acceptance.py
!/test_*.py
/test_focus_pause.py
!/docs/
!/assets/
/assets/*
!/assets/layered/
!/assets/happy/
!/assets/wakeup/
!/assets/prone/
!/assets/typing/
!/assets/rice/
__pycache__/
*.pyc
*.log
.env*
.venv/
venv/
